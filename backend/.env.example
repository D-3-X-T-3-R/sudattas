# ============================================================
# Sudattas Backend — Environment Variables
# Copy this file to the relevant service directory as .env
# and fill in real values. Never commit .env with real secrets.
#
# Production: set all secrets via environment or a secret manager;
# do not use example values in production. See CONFIG.md.
# ============================================================

# ----- Database (required by core_db_entities / core_operations) -----
# Full MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/SUDATTAS

# Connection pool settings (all optional — defaults shown)
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT_SEC=30
DB_IDLE_TIMEOUT_SEC=600
DB_MAX_LIFETIME_SEC=1800

# ----- gRPC (required) -----
# Address the gRPC server binds to (core_operations)
GRPC_SERVER=0.0.0.0:50051

# Address the GraphQL service uses to reach the gRPC server (graphql)
GRPC_URL=http://localhost:50051

# Shared bearer token for internal GraphQL→gRPC auth.
# Generate with: openssl rand -hex 32
# If unset, gRPC auth is disabled (dev/local only — always set in production).
GRPC_AUTH_TOKEN=change_me_use_openssl_rand_hex_32

# ----- Razorpay (required for live payments) -----
# From Razorpay Dashboard → Settings → API Keys (use Test keys for dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook signing secret: Dashboard → Webhooks → Add endpoint → copy "Secret"
# If set, POST /wheresthemoney/razorpay requires valid x-razorpay-signature
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ----- OAuth / JWT (required by graphql) -----
# Issuer for JWT validation. Backend fetches JWKS from issuer/.well-known/openid-configuration.
# Google OAuth (use your frontend's id_token as Bearer token):
OAUTH_DOMAIN=https://accounts.google.com
# Audience must match the JWT aud claim. For Google, use your OAuth 2.0 Client ID (same as frontend GOOGLE_CLIENT_ID).
OAUTH_AUDIENCE=your-client-id.apps.googleusercontent.com
# (OAUTH_AUDIANCE is also accepted for compatibility)

# ----- Internal auth / access control (required for server-to-server frontend -> graphql calls) -----
# Shared secret validated from X-Internal-Auth header.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change_me_internal_api_secret
# Temporary fallback only (deprecated): comma-separated JWT user IDs treated as admin
# if DB role lookup is unavailable. Prefer DB-backed role assignment via:
#   backend/database/scripts/bootstrap_admin_by_google_sub.sql
ADMIN_ALLOWED_USER_IDS=1

# ----- Twilio Verify (required for storefront phone OTP login) -----
# Create a Verify service in Twilio Console and copy these values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Redis / Session (optional) -----
# If set, Redis is used for session management; omit to disable sessions
REDIS_URL=redis://127.0.0.1:6379

# ----- Cloudflare R2 / Image storage (required if using image upload) -----
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=sudattas-images
R2_PUBLIC_URL=https://images.yourdomain.com

# R2 CORS: For browser uploads (admin Add Product), add a CORS policy on the bucket
# so requests from your app origin are allowed. Dashboard: R2 → bucket → Settings → CORS.
# See docs/R2_CORS.md for the exact JSON (include http://localhost:3000 and your production origin).

# Max upload size in MB (default: 10)
MAX_IMAGE_SIZE_MB=10

# ----- GraphQL server (optional) -----
# Socket address for the GraphQL HTTP server (default: 0.0.0.0:8080)
GRAPHQL_LISTEN_ADDR=0.0.0.0:8080
# Comma-separated allowed origins for session-authenticated CSRF checks.
# If set, session-auth requests without Origin/Referer in this list are rejected (403).
ALLOWED_ORIGINS=http://127.0.0.1:3000,https://app.sudattas.com
# Base URL used to build robots.txt and sitemap.xml links.
SITEMAP_BASE_URL=https://www.sudattas.com

# ----- Resilience & rate limiting (optional) -----
# Per-IP rate limit: requests per minute for GraphQL (0 = disabled, default 240)
RATE_LIMIT_PER_MINUTE=240
# Per-IP rate limit for webhook endpoints (0 = disabled, default 120)
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
# Trust X-Forwarded-For / X-Real-Ip when deriving client IP for rate limiting.
# Keep disabled if GraphQL is internet-facing directly; enable when GraphQL is only
# reachable behind your trusted proxy/app server (e.g. Next.js / Nginx / LB).
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# GraphQL query depth limit (default 10); rejects overly nested queries with 400
GRAPHQL_MAX_QUERY_DEPTH=10
# Optional: GraphQL complexity limit (depth-weighted score). If set, queries above this score get 400.
# GRAPHQL_MAX_QUERY_COMPLEXITY=250
# gRPC server metrics: HTTP bind for GET /metrics (default 0.0.0.0:9090) when running core_operations binary
# GRPC_METRICS_ADDR=0.0.0.0:9090
# gRPC client: request timeout (s), connect timeout (s), connect retries
GRPC_REQUEST_TIMEOUT_SEC=30
GRPC_CONNECT_TIMEOUT_SEC=10
GRPC_CONNECT_RETRIES=2
# Circuit breaker: open after N connect failures, cooldown (s). If you see "gRPC circuit breaker open",
# ensure the gRPC server (core_operations) is running at GRPC_URL; wait for cooldown or restart GraphQL to reset.
GRPC_CIRCUIT_BREAKER_FAILURES=5
GRPC_CIRCUIT_BREAKER_COOLDOWN_SEC=30
# Admin role lookup cache TTL (seconds) for JWT sub -> role resolution (default 300)
ADMIN_ROLE_CACHE_TTL_SEC=300
# Idempotency: cache window in hours for place_order and capture_payment (default 24)
IDEMPOTENCY_WINDOW_HOURS=24

# ----- Shiprocket (optional — admin mark shipped with shiprocketBook: true) -----
# Prefer a dedicated API user: Shiprocket panel → Settings → API → Create API User.
# If unavailable, you can use your current Shiprocket login credentials.
SHIPROCKET_EMAIL=api_user@example.com
SHIPROCKET_PASSWORD=your_api_user_password
# Webhook token for POST /blastoff/parcelupdate (sent in x-shiprocket-token header).
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here
# Pickup location nickname exactly as in Shiprocket → Settings → Pickup addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Pickup pincode used for checkout quote API (/courier/serviceability)
SHIPROCKET_PICKUP_POSTCODE=700001
# Optional overrides
# SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
# SHIPROCKET_ESTIMATED_UNIT_WEIGHT_KG=0.65
# SHIPROCKET_PACKAGE_LENGTH_CM=10
# SHIPROCKET_PACKAGE_BREADTH_CM=10
# SHIPROCKET_PACKAGE_HEIGHT_CM=10
# If assign AWB fails without courier, set courier id from Shiprocket courier list / serviceability API
# SHIPROCKET_COURIER_ID=

# ----- Outbox / transactional email (optional) -----
# core_operations outbox worker: after enqueue, delivery loads order + user and sends or logs.
# EMAIL_PROVIDER=log (default): log plain-text body via tracing; no external API.
# EMAIL_PROVIDER=resend: POST to https://api.resend.com/emails (requires API key + verified from).
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Sudattas <orders@yourdomain.com>"
# Copy in email templates (order confirmation, shipped, etc.)
STORE_DISPLAY_NAME=Sudattas
STOREFRONT_URL=https://sudattas.com
# Test-only: simulate delivery failure for outbox retry tests (unset in normal runs)
# OUTBOX_DELIVER_FAIL=1
# core_operations: background poll for pending outbox rows (deliver email then mark Processed).
# Uses a second connection pool (same DATABASE_URL); disable if you prefer an external cron calling a future RPC.
# OUTBOX_DISABLE_WORKER=1
# OUTBOX_POLL_INTERVAL_SEC=30
# OUTBOX_BATCH_LIMIT=50

# ----- Logging -----
# Tracing filter for GraphQL service (logs are JSON in production)
RUST_LOG=info

# ----- Test-only envs (used by backend graphql E2E tests) -----
# GraphQL endpoint used by tests.
GRAPHQL_URL=http://127.0.0.1:8080
# Session id used by tests for guest/session-auth flows.
GRAPHQL_SESSION_ID=
# User IDs used by internal-auth E2E flows.
GRAPHQL_E2E_CUSTOMER_USER_ID=9002
GRAPHQL_E2E_ADMIN_USER_ID=9001
# Optional test DB override used by backend integration tests.
TEST_DATABASE_URL=
