# GraphQL API (Next.js embeds NEXT_PUBLIC_* at build time)
# Required for storefront to load products from your DB (not sample data). Default: http://localhost:8080/v2
NEXT_PUBLIC_GRAPHQL_URL=

# Phone OTP (Twilio Verify): defaults to sms. Use whatsapp only after Twilio Verify WhatsApp + sender are configured.
# NEXT_PUBLIC_PHONE_OTP_CHANNEL=sms

# Storefront catalog now uses guest sessions (`POST /session/guest`) for public reads.
# Admin credentials must never be exposed in NEXT_PUBLIC_* variables.

# When the GraphQL server sets ALLOWED_ORIGINS, server-side session calls (Next API routes) must send Origin.
# Set to the URL you use in the browser (e.g. http://localhost:3000). Optional if ALLOWED_ORIGINS is unset.
# STOREFRONT_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_SITE_URL is also used as a fallback Origin for gqlWithSession.

# Google OAuth (NextAuth) — required for admin panel /imtheboss
# Generate AUTH_SECRET: npx auth secret  (or openssl rand -base64 32)
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000   # Production: your app URL
# GOOGLE_CLIENT_ID=     # From Google Cloud Console OAuth 2.0 Client
# GOOGLE_CLIENT_SECRET=
# In Google Console, add redirect URI: http://localhost:3000/api/auth/callback/google
# Restrict admin to specific Google accounts (comma-separated emails). If unset, any Google user can sign in.
# ADMIN_ALLOWED_EMAILS=admin@example.com,other@example.com

# Optional: checkout (placeOrder) uses your first saved shipping address from the API.
# For local dev without addresses, set a valid shipping_address_id from your DB:
# NEXT_PUBLIC_DEFAULT_SHIPPING_ADDRESS_ID=1
