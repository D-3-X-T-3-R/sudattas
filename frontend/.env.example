# ============================================================
# Sudattas Frontend - Environment Variables
# Copy to .env.local (or .env) and fill real values.
# Do not commit real secrets.
# ============================================================

# ---------- Public (safe for browser) ----------
# GraphQL endpoint the browser calls.
NEXT_PUBLIC_GRAPHQL_URL=http://127.0.0.1:8080/v2
# Public site URL used for canonical/share URLs and origin inference.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Storefront home path used by admin shell "Back to store" links.
NEXT_PUBLIC_STORE_URL=/
# Optional custom remote image hostname for next/image.
# Example: pub-xxxxxxxx.r2.dev or images.sudattas.com
# NEXT_PUBLIC_IMAGE_HOST=cdn.example.com
# Optional default shipping address id for seeded demos.
# NEXT_PUBLIC_DEFAULT_SHIPPING_ADDRESS_ID=1
# Optional OTP channel override (sms | whatsapp).
NEXT_PUBLIC_PHONE_OTP_CHANNEL=sms
# Optional free-shipping banner threshold, in paise. Defaults to 100000 (₹1,000) if unset.
# NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_MINOR=100000

# ---------- Server-only (never expose as NEXT_PUBLIC_*) ----------
# Backend GraphQL endpoint used by server routes (falls back to NEXT_PUBLIC_GRAPHQL_URL if unset).
GRAPHQL_URL=http://127.0.0.1:8080/v2
# Optional metrics scrape targets.
# GRAPHQL_METRICS_URL=http://127.0.0.1:8080/metrics
# CORE_OPS_METRICS_URL=http://127.0.0.1:9090/metrics

# Storefront origin used for CSRF-compatible server calls.
STOREFRONT_ORIGIN=http://127.0.0.1:3000

# Frontend-only storefront launch gate.
# IS_STOREFRONT_READY=1 renders the public storefront normally.
# Any other value, including an unset variable, serves the coming-soon page for public routes.
# When IS_STOREFRONT_READY=1, public storefront routes also require GRAPHQL_URL's /ready endpoint
# to respond successfully; otherwise customers see the same animated unavailable page.
IS_STOREFRONT_READY=1

# Required for NextAuth session/jwt encryption.
# Generate a long random value (>=32 chars).
AUTH_SECRET=replace_with_long_random_secret
# Optional alias for compatibility with Auth.js/NextAuth defaults.
# Keep equal to AUTH_SECRET when both are set.
# NEXTAUTH_SECRET=replace_with_long_random_secret
# Required by NextAuth in dev/prod (prevents NEXTAUTH_URL warnings).
NEXTAUTH_URL=http://127.0.0.1:3000

# Google OAuth credentials (required for Google sign-in).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated admin allowlist (only for /imtheboss).
ADMIN_ALLOWED_EMAILS=admin@example.com

# Required for frontend server->backend trusted internal auth headers.
# Must match backend INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=replace_with_same_backend_internal_secret

# ---------- Store policy display (server-rendered pages/api) ----------
# Keep these aligned with backend policy values.
CANCEL_WINDOW_HOURS=12
PICKUP_DELAY_HOURS=48
